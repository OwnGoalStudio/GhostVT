          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve lo que muestra una sesión de terminal, como texto sin formato. También puede incluir el historial de desplazamiento de la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
