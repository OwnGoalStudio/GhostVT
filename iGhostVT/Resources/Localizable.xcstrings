    "The background helper that runs your terminals is switched off. Turn it back on to open a terminal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrund-Helfer, der deine Terminals ausführt, ist ausgeschaltet. Schalte ihn wieder ein, um ein Terminal zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The background helper that runs your terminals is switched off. Turn it back on to open a terminal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente en segundo plano que ejecuta tus terminales está desactivado. Vuelve a activarlo para abrir un terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant en arrière-plan qui exécute vos terminaux est désactivé. Réactivez-le pour ouvrir un terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistente in background che esegue i tuoi terminali è disattivato. Riattivalo per aprire un terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルを実行するバックグラウンドヘルパーがオフになっています。オンに戻すとターミナルを開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널을 실행하는 백그라운드 헬퍼가 꺼져 있습니다. 다시 켜면 터미널을 열 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O assistente em segundo plano que executa seus terminais está desativado. Ative-o novamente para abrir um terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновый помощник, который запускает терминалы, выключен. Включите его снова, чтобы открыть терминал."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行终端的后台助手已关闭。请重新开启后再打开终端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行終端機的背景助手已關閉。請重新開啟後再開啟終端機。"
          }
        }
      }
    },
    "The bar above the keyboard shows these keys in this order. Scroll sideways if they do not all fit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leiste über der Tastatur zeigt diese Tasten in dieser Reihenfolge. Scrolle seitwärts, wenn nicht alle hineinpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bar above the keyboard shows these keys in this order. Scroll sideways if they do not all fit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra sobre el teclado muestra estas teclas en este orden. Desplázate lateralmente si no caben todas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre au-dessus du clavier affiche ces touches dans cet ordre. Faites défiler latéralement si elles ne tiennent pas toutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra sopra la tastiera mostra questi tasti in questo ordine. Scorri lateralmente se non entrano tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボード上のバーには、これらのキーがこの順序で表示されます。すべて収まらない場合は横にスクロールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드 위 막대에 이 키들이 이 순서로 표시됩니다. 전부 들어가지 않으면 옆으로 스크롤하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barra acima do teclado mostra estas teclas nesta ordem. Role para o lado se não couberem todas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На панели над клавиатурой эти клавиши показаны в таком порядке. Прокрутите вбок, если они не помещаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键盘上方的快捷栏将按此顺序显示这些按键。若无法全部显示，可左右滑动查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵盤上方的快捷列將按此順序顯示這些按鍵。若無法全部顯示，可左右滑動查看。"
          }
        }
      }
    },
    "The bar stays down while a hardware keyboard is connected." : {
