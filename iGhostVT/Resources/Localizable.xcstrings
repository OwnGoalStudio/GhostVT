        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restituisce tutte le sessioni del terminale in iGhostVT, che una scheda le mostri o meno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT のすべてのターミナルセッションを返します。タブに表示されているかどうかは問いません。"
