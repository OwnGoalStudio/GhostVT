    "Waits until the session's shell is back at its prompt, or until the time limit passes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet, bis die Shell der Sitzung wieder an der Eingabeaufforderung ist oder das Zeitlimit abläuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waits until the session's shell is back at its prompt, or until the time limit passes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera hasta que el shell de la sesión vuelva al prompt o hasta que pase el tiempo límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attend que le shell de la session soit revenu à l’invite, ou que la limite de temps soit écoulée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attende che la shell della sessione sia tornata al prompt o che scada il limite di tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションのシェルがプロンプトに戻るか、制限時間が過ぎるまで待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션의 셸이 프롬프트로 돌아오거나 제한 시간이 지날 때까지 기다립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarda até que o shell da sessão volte ao prompt ou até que o tempo limite passe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ждёт, пока оболочка сеанса вернётся к приглашению или истечёт лимит времени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待会话的 shell 回到提示符，或直到时限结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待工作階段的 shell 回到提示字元，或直到時限結束。"
          }
        }
      }
