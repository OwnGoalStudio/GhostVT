    "Up to three characters, sent exactly as typed. A single letter also works with Control." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu drei Zeichen, genau so gesendet, wie du sie eingibst. Ein einzelner Buchstabe funktioniert auch mit Control."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to three characters, sent exactly as typed. A single letter also works with Control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta tres caracteres, enviados tal como los escribes. Una sola letra también funciona con Control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à trois caractères, envoyés tels que vous les saisissez. Une seule lettre fonctionne aussi avec Contrôle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a tre caratteri, inviati esattamente come li digiti. Una sola lettera funziona anche con Control."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大 3 文字。入力したとおりに送信されます。1 文字なら Control と組み合わせても使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 3자이며 입력한 그대로 전송됩니다. 한 글자는 Control과 함께 사용할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até três caracteres, enviados exatamente como você digita. Uma única letra também funciona com Control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До трёх символов, отправляются в точности как введены. Одна буква работает и с Control."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多 3 个字符，按原样发送。单个字母也可与 Control 键组合使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多 3 個字元，按原樣傳送。單一字母也可與 Control 鍵組合使用。"
          }
        }
      }
    },
    "Up to three characters, sent exactly as typed. A single letter works with Control just like a letter on the keyboard." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu drei Zeichen, genau so gesendet, wie sie eingegeben werden. Ein einzelner Buchstabe funktioniert mit Control genau wie ein Buchstabe auf der Tastatur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to three characters, sent exactly as typed. A single letter works with Control just like a letter on the keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta tres caracteres, enviados tal como se escriben. Una sola letra funciona con Control igual que una letra del teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à trois caractères, envoyés tels qu’ils sont saisis. Une seule lettre fonctionne avec Contrôle comme une lettre du clavier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a tre caratteri, inviati esattamente come vengono digitati. Una singola lettera funziona con Control proprio come una lettera della tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大 3 文字を、入力したとおりに送信します。1 文字のときは、キーボードの文字と同じように Control と組み合わせて使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 3자를 입력한 그대로 보냅니다. 한 글자일 때는 키보드의 글자와 똑같이 Control과 함께 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até três caracteres, enviados exatamente como digitados. Uma única letra funciona com Control como qualquer letra do teclado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До трёх символов, отправляются ровно так, как введены. Одна буква работает с Control так же, как буква на клавиатуре."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多输入 3 个字符，按原样发送。单个字母可与 Control 键组合使用，效果与键盘上的字母键相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多輸入 3 個字元，並將按原樣送出。單一字母可與 Control 鍵組合使用，效果與鍵盤上的字母按鍵相同。"
          }
        }
      }
    },
