          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает все сеансы терминала в iGhostVT, независимо от того, показывает ли их вкладка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
