    "Starts a shell in the background and returns the session. Show it in a tab or send text to it later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet eine Shell im Hintergrund und gibt die Sitzung zurück. Zeige sie später in einem Tab an oder sende Text an sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts a shell in the background and returns the session. Show it in a tab or send text to it later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia un shell en segundo plano y devuelve la sesión. Muéstrala después en una pestaña o envíale texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre un shell en arrière-plan et renvoie la session. Affichez-la ensuite dans un onglet ou envoyez-lui du texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una shell in background e restituisce la sessione. Mostrala in una scheda o inviale del testo in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドでシェルを開始し、そのセッションを返します。あとでタブに表示したり、テキストを送信したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드에서 셸을 시작하고 세션을 반환합니다. 나중에 탭에 표시하거나 텍스트를 보낼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia um shell em segundo plano e retorna a sessão. Mostre-a em uma aba ou envie texto para ela depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает оболочку в фоне и возвращает сеанс. Позже его можно показать во вкладке или отправить в него текст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台启动 shell 并返回该会话。之后可以在标签页中显示它，或向它发送文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在背景啟動 shell 並回傳該工作階段。之後可以在分頁中顯示它，或向它傳送文字。"
          }
        }
      }
    },
