    "The app and the terminal daemon are different versions. Reinstall iGhostVT to update both." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App und Terminal-Daemon haben unterschiedliche Versionen. Installiere iGhostVT neu, um beide zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app and the terminal daemon are different versions. Reinstall iGhostVT to update both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app y el daemon del terminal tienen versiones distintas. Reinstala iGhostVT para actualizar ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app et le démon du terminal n’ont pas la même version. Réinstallez iGhostVT pour mettre à jour les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app e il daemon del terminale hanno versioni diverse. Reinstalla iGhostVT per aggiornare entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリとターミナルデーモンのバージョンが異なります。iGhostVT を再インストールして、両方を更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱과 터미널 데몬의 버전이 다릅니다. iGhostVT를 다시 설치하여 둘 다 업데이트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app e o daemon do terminal estão em versões diferentes. Reinstale o iGhostVT para atualizar os dois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версии приложения и службы терминала не совпадают. Переустановите iGhostVT, чтобы обновить обе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 与终端守护进程版本不一致。请重新安装 iGhostVT 以同时更新两者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 與終端機常駐程式版本不一致。請重新安裝 iGhostVT 以同時更新兩者。"
          }
        }
      }
    },
    "The background helper is missing. Reinstall iGhostVT." : {
