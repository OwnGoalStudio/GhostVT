    },
    "The session limit has been reached. Close a session and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die maximale Anzahl an Sitzungen ist erreicht. Schließe eine Sitzung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session limit has been reached. Close a session and try again."
          }
        },
        "es" : {
