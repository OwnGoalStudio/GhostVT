          }
        }
      }
    },
    "This closes every terminal and stops everything running in them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Terminals werden geschlossen und alles beendet, was darin läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrarán todos los terminales y se detendrá todo lo que se esté ejecutando en ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les terminaux seront fermés et tout ce qui s’y exécute sera arrêté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i terminali verranno chiusi e tutto ciò che vi è in esecuzione verrà interrotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのターミナルを閉じ、実行中のプログラムをすべて終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 터미널을 닫고 그 안에서 실행 중인 모든 항목을 중단합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os terminais serão fechados e tudo o que estiver em execução neles será interrompido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все терминалы будут закрыты, а всё, что в них запущено, — остановлено."
          }
