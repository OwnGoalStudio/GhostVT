    "Drag to reorder. Removed dividers and custom keys disappear; standard keys move back to the list below." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Umordnen ziehen. Entfernte Trenner und eigene Tasten verschwinden; Standardtasten wandern zurück in die Liste unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar. Los separadores y teclas personalizadas eliminados desaparecen; las teclas estándar vuelven a la lista de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser. Les séparateurs et touches personnalisées supprimés disparaissent ; les touches standard retournent dans la liste ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare. Divisori e tasti personalizzati rimossi scompaiono; i tasti standard tornano nell'elenco sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで並べ替えます。削除した区切りとカスタムキーは消え、標準キーは下のリストに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 순서를 바꿉니다. 제거한 구분선과 사용자 지정 키는 사라지고, 표준 키는 아래 목록으로 돌아갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar. Separadores e teclas personalizadas removidos desaparecem; teclas padrão voltam para a lista abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите, чтобы изменить порядок. Удалённые разделители и свои клавиши исчезают; стандартные возвращаются в список ниже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动可调整顺序。移除的分隔点和自定义按键会直接消失；标准按键会回到下方列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳可調整順序。移除的分隔點和自訂按鍵會直接消失；標準按鍵會回到下方列表。"
          }
        }
      }
    },
