    "The bar above the keyboard shows these keys in this order and scrolls sideways when they don't fit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leiste über der Tastatur zeigt diese Tasten in dieser Reihenfolge und scrollt seitwärts, wenn sie nicht passen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra sobre el teclado muestra estas teclas en este orden y se desplaza lateralmente cuando no caben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre au-dessus du clavier affiche ces touches dans cet ordre et défile latéralement quand elles ne tiennent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra sopra la tastiera mostra questi tasti in quest'ordine e scorre lateralmente quando non entrano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボード上部のバーにこの順番でキーが表示され、収まらない場合は横にスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드 위 막대에 이 순서대로 키가 표시되며, 공간이 부족하면 옆으로 스크롤됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barra acima do teclado mostra estas teclas nesta ordem e rola para o lado quando não cabem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Панель над клавиатурой показывает эти клавиши в этом порядке и прокручивается вбок, когда они не помещаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键盘上方的按键条会按此顺序显示这些按键，放不下时可以左右滑动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵盤上方的按鍵列會依此順序顯示這些按鍵，放不下時可左右捲動。"
          }
        }
      }
    },
    "The shell and anything running in it will be terminated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Shell und alles, was darin läuft, werden beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se terminará el shell y todo lo que se esté ejecutando en él."
          }
