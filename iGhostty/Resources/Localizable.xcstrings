    "The shell and anything running in it will be terminated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Shell und alles, was darin läuft, werden beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se terminará el shell y todo lo que se esté ejecutando en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le shell et tout ce qui s’y exécute seront arrêtés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La shell e tutto ciò che vi è in esecuzione verranno terminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルと実行中のプログラムはすべて終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸과 그 안에서 실행 중인 모든 항목이 종료됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O shell e tudo o que estiver em execução nele serão encerrados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оболочка и всё, что в ней запущено, будут завершены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 及其中正在运行的所有程序都将被终止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 及其中正在執行的所有程式都將被終止。"
          }
        }
      }
    },
    "Themes come from the Ghostty theme catalog and apply to every tab in every window." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Themes stammen aus dem Ghostty-Theme-Katalog und gelten für jeden Tab in jedem Fenster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los temas provienen del catálogo de temas de Ghostty y se aplican a todas las pestañas de todas las ventanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les thèmes proviennent du catalogue de thèmes Ghostty et s'appliquent à tous les onglets de toutes les fenêtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I temi provengono dal catalogo dei temi di Ghostty e si applicano a tutte le schede in tutte le finestre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テーマは Ghostty のテーマカタログから提供され、すべてのウインドウのすべてのタブに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테마는 Ghostty 테마 카탈로그에서 제공되며 모든 윈도우의 모든 탭에 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os temas vêm do catálogo de temas do Ghostty e se aplicam a todas as abas de todas as janelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Темы берутся из каталога тем Ghostty и применяются ко всем вкладкам во всех окнах."
          }
