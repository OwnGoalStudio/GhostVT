    "Closed shells are gone for good; a new tab starts a fresh one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschlossene Shells sind endgültig weg; ein neuer Tab startet eine frische."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los shells cerrados desaparecen para siempre; una pestaña nueva inicia uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les shells fermés sont définitivement perdus ; un nouvel onglet en démarre un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le shell chiuse sono perse per sempre; una nuova scheda ne avvia una nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じたシェルは元に戻せません。新しいタブで新しいシェルが起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닫힌 셸은 되돌릴 수 없습니다. 새 탭은 새 셸을 시작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
