    "A closed terminal cannot be reopened. Start a new one whenever you need it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein geschlossenes Terminal lässt sich nicht wieder öffnen. Starte jederzeit ein neues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terminal cerrado no se puede volver a abrir. Crea uno nuevo cuando lo necesites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terminal fermé ne peut pas être rouvert. Démarrez-en un nouveau quand vous en avez besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terminale chiuso non può essere riaperto. Avviane uno nuovo quando ti serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じたターミナルは元に戻せません。必要になったら新しく開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닫은 터미널은 다시 열 수 없습니다. 필요할 때 새로 시작하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um terminal fechado não pode ser reaberto. Crie um novo quando precisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрытый терминал нельзя открыть снова. Создайте новый, когда он понадобится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭的终端无法重新打开。可随时新建终端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已關閉的終端機無法重新開啟。可隨時新增終端機。"
          }
        }
      }
    },
    "A custom key types the characters you enter, together with any modifier keys that are switched on." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine eigene Taste tippt die von dir eingegebenen Zeichen, zusammen mit allen aktivierten Modifikatortasten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tecla personalizada escribe los caracteres que introduzcas, junto con las teclas modificadoras que estén activadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une touche personnalisée saisit les caractères que vous entrez, avec les touches de modification activées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tasto personalizzato digita i caratteri che inserisci, insieme ai tasti modificatori attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムキーは、入力した文字を、オンになっている修飾キーとともに送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 키는 입력한 문자를 켜져 있는 수정 키와 함께 입력합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma tecla personalizada digita os caracteres que você inserir, junto com as teclas modificadoras que estiverem ativadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Своя клавиша вводит указанные символы вместе с включёнными клавишами-модификаторами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义按键将输入所设定的字符，并结合当前已启用的修饰键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂按鍵將輸入所設定的字元，並結合目前啟用的修飾鍵。"
          }
        }
      }
    },
